{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"emitDeclarationOnly": true,
		"declaration": true,
		"declarationMap": true,
		"outDir": "dist",
		"rootDir": "src",
		// Our source imports carry .ts extensions so the pure modules run under bare Node. This
		// rewrites them to .js in the declarations, which is what a consumer needs to see.
		"rewriteRelativeImportExtensions": true
	},
	"include": ["src"]
}
